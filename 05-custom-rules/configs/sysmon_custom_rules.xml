<group name="local,sysmon,custom_detections,">

  <!-- Closes gap C: scheduled task created with schtasks.exe -->
  <rule id="100010" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s/create\s</field>
    <description>Scheduled task created with schtasks.exe: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- Closes gap E: PowerShell made an outbound network connection.
       Child of built-in rule 92101 (level 0), not of 61605: 92101 matches
       PowerShell TCP connections first and would otherwise swallow the event. -->
  <rule id="100011" level="6">
    <if_sid>92101</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.initiated">^true$</field>
    <description>PowerShell made an outbound connection to $(win.eventdata.destinationIp):$(win.eventdata.destinationPort)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1071.001</id>
    </mitre>
  </rule>

  <!-- Tuning: rule 92213 fires for PowerShell's own script-policy test file.
       Wazuh stores Windows paths with doubled backslashes, hence \\+ -->
  <rule id="100012" level="3">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+WindowsPowerShell\\+v1\.0\\+powershell\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\+AppData\\+Local\\+Temp\\+__PSScriptPolicyTest_[a-z0-9]+\.[a-z0-9]+\.ps1$</field>
    <description>Known benign: PowerShell script policy test file (tuned from rule 92213)</description>
  </rule>

</group>
